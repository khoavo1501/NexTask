:8080 {
  encode zstd gzip
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
  handle /api/* {
    reverse_proxy api:4000
  }
  handle /socket.io/* {
    reverse_proxy api:4000
  }
  handle {
    reverse_proxy web:3000
  }
}
